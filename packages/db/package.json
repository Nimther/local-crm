{
  "name": "@mega-crm/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*.js": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "relocate:default-partition-rows": "tsx scripts/relocate-default-partition-rows.ts",
    "db:audit-sends-history": "tsx scripts/audit-sends-history.ts",
    "db:count-send-event-duplicates": "tsx scripts/count-send-event-duplicates.ts",
    "db:resolve-send-event-duplicates": "tsx scripts/count-send-event-duplicates.ts --resolve",
    "db:rehash-suppressions": "tsx scripts/rehash-suppressions.ts",
    "replay:webhook-journal": "tsx scripts/replay-webhook-journal.ts",
    "db:audit-missing-constraints": "tsx scripts/audit-missing-constraints.ts",
    "db:count-member-duplicates": "tsx scripts/count-member-duplicates.ts",
    "db:resolve-member-duplicates": "tsx scripts/count-member-duplicates.ts --resolve",
    "db:check-empty-diff": "tsx scripts/check-empty-diff.ts",
    "test:rehearsal": "vitest run src/__tests__/migration-rollback-rehearsal.test.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "bullmq": "5.79.1",
    "@mega-crm/redaction": "0.1.0",
    "@mega-crm/shared-schemas": "0.1.0",
    "@mega-crm/queue-core": "0.1.0"
  },
  "devDependencies": {
    "@mega-crm/contacts-core": "0.1.0",
    "@mega-crm/delivery-core": "0.1.0",
    "@mega-crm/test-support": "0.1.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}
