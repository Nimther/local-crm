# Phase 14 plan 08 (D-01, D-09, D-10, DB-13, OPS-01/OPS-02). Documentation
# for every variable docker/docker-compose.prod.yml and the applications it
# runs require -- NOT configuration. No real value lives in this file. The
# actual values live in the operator's own externally-resolved env file
# (whatever MEGA_CRM_ENV_FILE points at on the VPS, outside any git working
# tree) -- the SAME convention every secret in this project has followed
# since Phase 8 (scripts/env-path.mjs). This file exists so
# `docker compose -f docker/docker-compose.prod.yml --env-file
# docker/prod.env.example config` resolves cleanly for local/CI validation
# without a real secrets file, and so an operator has one place that names
# every variable and where its real value should come from.
#
# Two kinds of line below:
#   - genuine credentials/secrets: left EMPTY here, always. Never fill these
#     in in THIS file -- put the real value only in your own
#     MEGA_CRM_ENV_FILE.
#   - non-secret operational tuning knobs (memory limits, connection/buffer
#     sizing, the stop-grace-period placeholder): shown with their real
#     conservative DEFAULT, matching the value docker-compose.prod.yml's own
#     `${VAR:-default}` interpolation falls back to if unset. Revisit these
#     at real provisioning time -- see docs/runbooks/production-topology.md's
#     "Sizing" section for the derivation and the explicit revisit triggers.
#     A default that is never revisited becomes the production value by
#     omission.

# -----------------------------------------------------------------------------
# Deploy identity (compose-level interpolation -- filled by the deploy
# script, plan 14-09, immediately before every `docker compose` invocation)
# -----------------------------------------------------------------------------

# Lowercase `ghcr.io/<owner>/<repo>` -- .github/workflows/images.yml computes
# this same value (owner/repo casing varies per GitHub account; GHCR requires
# lowercase). Not a secret -- shown below as this repository's own real
# value, uncommented, so `docker compose config` resolves a real, valid image
# reference rather than an empty one. A fork should change this line, not
# delete it.
GHCR_IMAGE_BASE=ghcr.io/nimther/local-crm

# The full git SHA of the commit whose images were pushed by images.yml --
# NEVER "latest", never a branch name (OPS-01/OPS-02, T-14-49). The deploy
# script (plan 14-09) overwrites this per invocation; the placeholder below
# is a syntactically valid 40-hex-character shape, not a real build, so
# `docker compose config` and scripts/validate-prod-compose.mjs's fallback
# resolution have something concrete to check "is this a mutable tag"
# against (it is not -- it is SHA-shaped) without this file claiming to name
# a real deployed commit.
IMAGE_TAG=0000000000000000000000000000000000000000

# The public hostname Caddy requests an ACME certificate for (D-02). Not a
# secret -- shown below as a placeholder domain so `docker compose config`
# resolves; every real deploy sets this to the actual production hostname.
SITE_ADDRESS=example.com

# Absolute path to the operator's own externally-resolved secrets file
# (scripts/env-path.mjs's convention) -- outside any git working tree, most
# commonly a root-owned path on the VPS such as /etc/mega-crm/production.env,
# never this repository's own checkout. docker-compose.prod.yml's `env_file:`
# entries mark this `required: false` specifically so this example file (and
# any CI validation using it) can resolve `docker compose config` without a
# real file existing at this path -- at real deploy time the path MUST exist
# and be readable, or api/worker/migrate start with none of their secrets.
MEGA_CRM_ENV_FILE=/etc/mega-crm/production.env

# -----------------------------------------------------------------------------
# Sizing (D-09, Pitfall 19) -- non-secret; every default below is derived and
# explained in docs/runbooks/production-topology.md's "Sizing" section, not
# guessed. Revisit ALL of these once the real VPS is provisioned (see that
# runbook's "Minimum viable VPS" and revisit-trigger notes) -- this plan's
# checkpoint decision ("parameterize-with-minimum") accepted the risk that an
# un-revisited default becomes the production value by omission, and states
# that risk here explicitly rather than leaving it implicit.
# -----------------------------------------------------------------------------

DB_MEM_LIMIT=2048m
# Pitfall 19: negative favors survival under host memory pressure -- only
# meaningful together with DB_MEM_LIMIT above (an unset memory limit lets a
# container exhaust host RAM before the kernel ever compares scores).
DB_OOM_SCORE_ADJ=-500
# Floor: must exceed 84 (plan 14-03's PG_POOL_SIZES summed total for one
# instance each of apps/api + apps/worker) -- the CI gate
# (scripts/validate-prod-compose.mjs) fails if this is not > 84.
PG_MAX_CONNECTIONS=200
# ~25% of DB_MEM_LIMIT -- the general Postgres tuning guideline; keep
# proportional if DB_MEM_LIMIT changes.
PG_SHARED_BUFFERS=512MB

REDIS_MEM_LIMIT=768m
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=1024m
WEB_MEM_LIMIT=256m
MIGRATE_MEM_LIMIT=512m

# ARCHITECTURE.md §10 / Pitfall 7: NEVER hand-typed for a real deploy -- the
# deploy script (plan 14-09) overwrites this every time from
# `node scripts/print-stop-grace-period.mjs`'s output (measured value at
# plan 14-04's commit: 60). The value below exists ONLY so
# `docker compose config` resolves against this file in isolation; if this
# drifts from the publish script's current output,
# scripts/validate-prod-compose.mjs's drift check fails on purpose --
# that check existing at all is the entire reason this plan's stop-grace-
# period task exists (Pitfall 7).
WORKER_STOP_GRACE_PERIOD_SECONDS=60

# -----------------------------------------------------------------------------
# Postgres bootstrap (docker/postgres/init-prod-roles.sql,
# docker/postgres/prod-tls-entrypoint.sh) -- ALL genuine secrets, always empty
# here.
# -----------------------------------------------------------------------------

POSTGRES_DB=mega_crm
POSTGRES_USER=postgres
# Cluster superuser password (official postgres image's own bootstrap var) --
# never reused for any application role below.
POSTGRES_PASSWORD=
# The three application-role passwords init-prod-roles.sql reads via psql's
# `\getenv` (never embedded in the SQL file itself) -- init fails loudly if
# any is unset (see that file's own header).
MEGA_CRM_APP_PASSWORD=
MEGA_CRM_SCAN_PASSWORD=
MEGA_CRM_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Application secrets -- delivered to api/worker/migrate containers via
# `env_file:` pointing at MEGA_CRM_ENV_FILE above (never listed individually
# in docker-compose.prod.yml itself). All genuine secrets, always empty here.
# Presence/format enforced by apps/api/src/env.ts and check-env.mjs; this
# list mirrors that enforcement, not a second source of truth for it.
# -----------------------------------------------------------------------------

NODE_ENV=production

# Every DSN below MUST carry `sslmode=require&uselibpqcompat=true`, not
# `sslmode=require` alone -- plan 14-03's own finding, verified against the
# installed pg-connection-string@2.14.0 source: a bare `sslmode=require`
# aliases to `verify-full` and FAILS the handshake against this plan's
# self-signed certificate (D-10). Example shape (no real host/credentials):
#   postgres://mega_crm_app:<MEGA_CRM_APP_PASSWORD>@db:5432/mega_crm?sslmode=require&uselibpqcompat=true
DATABASE_URL=
# Better Auth's drizzleAdapter pool, under the mega_crm_auth role (SEC-05).
AUTH_DATABASE_URL=
# apps/worker-only: the mega_crm_scan role's cross-workspace scan DSN
# (SEC-01/SEC-02) -- must NEVER appear in apps/api's own environment.
SCAN_DATABASE_URL=

REDIS_URL=redis://redis:6379

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
WEB_URL=
PUBLIC_APP_URL=

PLATFORM_SENDGRID_API_KEY=
PLATFORM_MAIL_FROM=
OPERATOR_ALERT_EMAIL=
# >=32 chars in production (apps/api/src/env.ts's production-gated check).
UNSUBSCRIBE_TOKEN_SECRET=

# Envelope-encryption provider for tenant SendGrid keys (Technology Stack:
# AWS KMS). apps/api/src/env.ts REFUSES KMS_PROVIDER=local when
# NODE_ENV=production (RESEARCH.md Pitfall 3) -- this must be "aws" here.
KMS_PROVIDER=aws
KMS_KEK_ID=
# Standard AWS SDK v3 credential-chain variables (packages/kms/src's
# KMSClient({}) takes no explicit config -- these are the SDK's own
# defaults, not a convention this codebase invented). Leave empty and rely on
# an attached IAM instance role/profile instead if the VPS provider supports
# one; only set these three if using long-lived IAM user credentials.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional -- defaults shown are this codebase's own documented defaults
# (apps/api/src/env.ts's API_PORT default; plan 14-04's
# WORKER_HEALTH_PORT_DEFAULT). Never published to the host either way
# (T-14-43) -- only listed here for completeness.
# API_PORT=4000
# WORKER_HEALTH_PORT=4100
