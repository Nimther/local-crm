# Copy this file to .env and fill in real values for local development.
# .env is gitignored -- never commit real secrets here.

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/mega_crm
TEST_DATABASE_URL=postgres://user:password@localhost:5432/mega_crm_test

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-16-chars
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# --- API server ---
API_PORT=4000
NODE_ENV=development

# --- Platform system email (D-07) ---
# The PLATFORM's OWN SendGrid account -- used only for system emails
# (verify / reset-password / invite). This is structurally separate from
# any tenant's BYO SendGrid key, which is stored per-workspace and
# encrypted (see Tenant key encryption below).
PLATFORM_SENDGRID_API_KEY=SG.replace-with-real-platform-key
PLATFORM_MAIL_FROM=noreply@example.com

# --- Tenant key encryption (envelope encryption of tenant SendGrid keys) ---
# KMS_PROVIDER=local is a dev-only static-KEK provider. Never use it when
# NODE_ENV=production (env.ts refuses to boot in that combination).
# KMS_PROVIDER=aws is the real KMS path for staging/prod and requires
# KMS_KEK_ID below.
KMS_PROVIDER=local
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
KMS_LOCAL_KEK=replace-with-openssl-rand-base64-32
# Required only when KMS_PROVIDER=aws:
# KMS_KEK_ID=
