# Postgres — the app DB role must NOT have BYPASSRLS (RLS is the last line of
# tenant-isolation defense; see packages/db/migrations/0001_rls_policies.sql).
# Local dev: `docker compose up db`, or a local Postgres 17 with a non-superuser
# application role created manually, e.g.:
#   CREATE ROLE mega_crm_app WITH LOGIN PASSWORD '...' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
#   CREATE DATABASE mega_crm OWNER mega_crm_app;
DATABASE_URL=postgresql://mega_crm_app:mega_crm_dev_pw@localhost:5432/mega_crm

# Used only by apps/api/src/test/db-fixture.ts (isolated test database, same
# non-superuser role so RLS is enforced during tests too).
TEST_DATABASE_URL=postgresql://mega_crm_app:mega_crm_dev_pw@localhost:5432/mega_crm_test

# better-auth
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:5173

API_PORT=4000
NODE_ENV=development
