# Fixture for scripts/__tests__/check-spec-env-coverage.test.mjs. Mirrors the
# shape of the real docker/prod.env.example: comments, blank lines, and both
# valued and empty assignments -- none of that should change what the
# extractor sees.

# A commented-out placeholder MUST be ignored -- it is not an active variable.
# API_PORT=4000

GHCR_IMAGE_BASE=ghcr.io/example/example
IMAGE_TAG=0000000000000000000000000000000000000000

# Genuine secrets are always empty here -- the extractor must still see the
# NAME on an empty assignment.
FIXTURE_SECRET_ONE=
FIXTURE_SECRET_TWO=

# A name that shares a prefix with another, longer name -- proves the
# extractor's own missing-name check (findMissingNames) does not credit the
# shorter name merely because the longer one is mentioned somewhere in the
# spec (word-boundary containment, not substring containment).
FIXTURE_PREFIX=
FIXTURE_PREFIX_LONGER=

# Repeated name (a real convention this repo uses across multiple compose
# services delivering the same secret) -- must be de-duplicated, not counted
# twice.
GHCR_IMAGE_BASE=ghcr.io/example/example
